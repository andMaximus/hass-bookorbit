diff --git a/client/src/lib/ingress-base.ts b/client/src/lib/ingress-base.ts
new file mode 100644
index 0000000..1fade79
--- /dev/null
+++ b/client/src/lib/ingress-base.ts
@@ -0,0 +1,82 @@
+/**
+ * Serving the client from a path prefix.
+ *
+ * Home Assistant Ingress serves an add-on under `/api/hassio_ingress/<session-token>/` on the
+ * Home Assistant origin, and mints that token per session, so the prefix cannot be baked in at
+ * build time. Any reverse proxy hosting BookOrbit at a subpath has the same problem.
+ *
+ * The prefix is taken from a `<base href>` tag that the proxy injects into `index.html`. When
+ * there is no such tag - every ordinary deployment - `basePath` is `/` and every helper below is
+ * an identity, so this module changes nothing outside a prefixed deployment.
+ *
+ * Assets and lazy chunks are handled by the build instead (`base: './'`), which makes them
+ * resolve relative to the document. This module covers what the build cannot: runtime URLs the
+ * app builds itself as server-absolute paths.
+ */
+
+function readBasePath(): string {
+  // Only an explicit <base> counts. Falling back to document.baseURI would read the current
+  // document's own path, so a deep link such as /books/123 would be mistaken for the prefix.
+  const element = typeof document === 'undefined' ? null : document.querySelector('base[href]')
+  if (!element) return '/'
+
+  const href = element.getAttribute('href') ?? '/'
+  const { pathname } = new URL(href, window.location.origin)
+  return pathname.endsWith('/') ? pathname : `${pathname}/`
+}
+
+export const basePath = readBasePath()
+
+/** True only when the app is served from a path prefix. */
+export const isPrefixed = basePath !== '/'
+
+/**
+ * Rewrites a server-absolute path onto the prefix. Protocol-relative (`//host`) and already
+ * prefixed paths are left alone, as is anything that is not an absolute path.
+ */
+export function withBase(path: string): string {
+  if (!isPrefixed) return path
+  if (!path.startsWith('/') || path.startsWith('//')) return path
+  if (path === basePath || path.startsWith(basePath)) return path
+  return basePath + path.slice(1)
+}
+
+/**
+ * Request interception happens here rather than at each call site. Most of the client goes
+ * through `lib/api.ts`, but the auth flows, the preference-sync composables and a few components
+ * call `fetch` directly, and the upload paths use XMLHttpRequest for progress events. Patching
+ * the two transports covers all of them, including any added later.
+ */
+function installRequestRewrites(): void {
+  const originalFetch = window.fetch.bind(window)
+  window.fetch = (input: RequestInfo | URL, init?: RequestInit): Promise<Response> => {
+    if (typeof input === 'string') return originalFetch(withBase(input), init)
+
+    if (input instanceof Request) {
+      const url = new URL(input.url, window.location.href)
+      if (url.origin === window.location.origin) {
+        const rewritten = withBase(url.pathname)
+        if (rewritten !== url.pathname) {
+          url.pathname = rewritten
+          return originalFetch(new Request(url.href, input), init)
+        }
+      }
+    }
+
+    return originalFetch(input, init)
+  }
+
+  const originalOpen = XMLHttpRequest.prototype.open
+  XMLHttpRequest.prototype.open = function open(
+    this: XMLHttpRequest,
+    method: string,
+    url: string | URL,
+    ...rest: unknown[]
+  ) {
+    const target = typeof url === 'string' ? withBase(url) : url
+    // eslint-disable-next-line @typescript-eslint/no-explicit-any, prefer-spread
+    return (originalOpen as any).apply(this, [method, target, ...rest])
+  } as typeof XMLHttpRequest.prototype.open
+}
+
+if (isPrefixed) installRequestRewrites()
